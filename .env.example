# Public API base used by fetch() in the browser.
# Local (Vite proxy): /api
# Vercel: either set the full API URL here, OR keep /api and set VITE_API_ORIGIN
# (production builds automatically use VITE_API_ORIGIN when base is relative).
VITE_API_BASE_URL=/api

# Absolute API origin — required for production + OAuth redirects.
# Example: https://assis-api-staging.ellwaa.com
VITE_API_ORIGIN=https://your-api.example.com

# Local-only: Vite dev-server proxy target for /api (ignored in production builds).
VITE_DEV_PROXY_TARGET=https://your-api.example.com
