# Public API base used by fetch() in the browser.
# Local (Vite proxy): /api
# Vercel / production: full API origin, e.g. https://your-api.example.com
VITE_API_BASE_URL=/api

# Absolute API origin for OAuth redirects (required when VITE_API_BASE_URL is relative).
VITE_API_ORIGIN=https://your-api.example.com

# Local-only: Vite dev-server proxy target for /api (not used in production builds).
VITE_DEV_PROXY_TARGET=https://your-api.example.com
